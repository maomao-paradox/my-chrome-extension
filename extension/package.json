{
  "name": "ma-extension",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev:study": "vite --open /pages/study.html",
    "dev:popup": "vite --open /pages/popup.html",
    "dev:options": "vite --open /pages/options.html",
    "dp": "npx depcruise --output-type json src > src/deps.json && vite --open /interactive-graph.html",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test:react": "vitest run --config vitest.config.react.ts",
    "cp": "du -sh dist && rm -rf /mnt/h/my-chrome-extension/* && cp -rf ./dist/ /mnt/h/my-chrome-extension/",
    "zip": "zip -r dist.zip dist/* && mv dist.zip /mnt/h/my-chrome-extension/",
    "build": "vite build"
  },
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@testing-library/user-event": "^14.6.3",
    "animejs": "^4.5.0",
    "antd": "5.22.5",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "dompurify": "^3.3.1",
    "file-saver": "^2.0.5",
    "fullpage.js": "^4.0.40",
    "gsap": "^3.14.2",
    "jquery": "3.5.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "markdown-it": "^14.1.0",
    "openseadragon": "^6.0.2",
    "pinyin-pro": "^3.27.0",
    "react": "19",
    "react-dom": "19",
    "three": "0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^9.39.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.43",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/jquery": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.3.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^17.3.10",
    "echarts": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "javascript-obfuscator": "^5.4.3",
    "jiti": "^2.7.0",
    "less": "^4.6.4",
    "postcss": "^8.5.26",
    "puppeteer-core": "^24.36.0",
    "sass": "^1.102.0",
    "sass-embedded": "^1.100.0",
    "tailwindcss": "3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-auto-import": "^20.1.0",
    "vite": "^6.0.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "^2.1.8"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2020": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "type": "module",
  "sweepy": {
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/.vercel/**",
      "**/.turbo/**",
      "**/.parcel-cache/**",
      "**/.cache/**",
      "**/.vite/**",
      "**/*.d.ts",
      ".sweepy-trash/**",
      "**/test/**",
      "**/tests/**",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/*.spec.*",
      "**/*.test.*",
      "**/*.snap",
      "**/*.log",
      "**/*.tmp",
      "**/.sweepy-report.*",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/cypress/**",
      "**/playwright/**",
      "**/.eslintcache",
      "**/.stylelintcache",
      "**/.DS_Store",
      "**/Thumbs.db"
    ],
    "output": "json",
    "types": [
      "js",
      "css",
      "assets"
    ],
    "customAliases": {
      "@components": "src/assets/components"
    },
    "customCssSafelist": [
      "^\\.status$",
      "^\\.active$",
      "^\\.suspended$"
    ]
  }
}
