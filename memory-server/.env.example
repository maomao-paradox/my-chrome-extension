# memory-server 环境变量示例（全部带默认值，按需覆盖）

# 服务监听主机（默认 127.0.0.1；容器内使用 0.0.0.0）
SERVER_HOST=0.0.0.0

# 服务监听端口（默认 8790）
SERVER_PORT=8790

# SQLite 连接串（默认 sqlite://data/memory.db；容器内使用 sqlite:///data/memory.db，绝对路径三个斜杠）
DATABASE_URL=sqlite:///data/memory.db

# 可选 API 令牌：设置后要求 Authorization: Bearer <token> 或 X-API-Key；留空/不设置则放行
# API_TOKEN=

# 允许的 CORS 源列表（逗号分隔；不设置则默认放行 chrome-extension://* 与本地 Vite 端口）
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# 请求体最大字节数（默认 10485760，即 10MB，覆盖导入备份的大 JSON 场景）
MAX_REQUEST_BYTES=10485760

# 日志级别（默认 info，可选 trace/debug/info/warn/error）
RUST_LOG=info
